{
  "Service": {
    "Name": "WindowsServiceStarter"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    },
    "File": {
      "Directory": "logs",
      "FileNamePrefix": "service",
      "MaxFileSizeMB": 10,
      "RetainDays": 14,
      "LogLevel": {
        "Default": "Information"
      }
    }
  },

  "Worker": {
    "MaxConsecutiveFailures": 5,
    "Jobs": {
      "Heartbeat": {
        "Enabled": true,
        "Interval": "00:05:00",
        "Timeout": "00:00:30",
        "RunOnStart": true
      },
      "FolderCleanup": {
        "Enabled": true,
        "Interval": "01:00:00",
        "Timeout": "00:10:00",
        "RunOnStart": true
      }
    }
  },

  "FolderCleanup": {
    "Path": "",
    "SearchPattern": "*.tmp",
    "OlderThanDays": 30,
    "Recursive": false,
    "DryRun": true
  }
}
